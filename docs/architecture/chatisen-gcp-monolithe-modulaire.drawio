        </mxCell>
        <mxCell id="row-8-body-2" parent="1" vertex="1" value="Le module Fichiers consulte les droits du salon via l’interface de Salons et messages avant tout accès au bucket." style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
