        </mxCell>
        <mxCell id="row-9-body-1" parent="1" vertex="1" value="HTTPS 443. Le module transfère les octets. Les métadonnées sont conservées dans PostgreSQL." style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
