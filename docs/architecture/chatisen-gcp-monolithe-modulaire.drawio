        <mxCell id="row-2-body-1" parent="1" vertex="1" value="HTTP 80 sur le réseau Compose. Page, assets Preact et Vite." style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="940" y="2145" width="1177" height="55" />
        </mxCell>
        <mxCell id="row-2-body-2" parent="1" vertex="1" value="Conteneur frontend accessible par Traefik sur le réseau Compose. Le port n’est pas publié sur l’hôte." style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
