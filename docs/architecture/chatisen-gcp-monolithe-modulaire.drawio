        </mxCell>
        <mxCell id="row-8-body-1" parent="1" vertex="1" value="Le module Fichiers reçoit le contexte authentifié et vérifie le droit sur le salon ou le fichier demandé." style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
