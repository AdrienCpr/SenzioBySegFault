        </mxCell>
        <mxCell id="row-3-body-0" parent="1" vertex="1" value="&lt;b&gt;API et chat&lt;/b&gt;&lt;br&gt;Traefik → Points d’entrée Fastify / Socket.IO" style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="237" y="2206" width="679" height="55" />
        </mxCell>
        <mxCell id="row-3-body-1" parent="1" vertex="1" value="REST, événements Socket.IO et signalisation. Les entrées appellent les modules dans le même processus." style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="940" y="2206" width="1177" height="55" />
        </mxCell>
        <mxCell id="row-3-body-2" parent="1" vertex="1" value="Réseau Compose privé. Valider le JWT Entra à l’entrée, puis vérifier les droits dans le module concerné." style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="2140" y="2206" width="1270" height="55" />
        </mxCell>
