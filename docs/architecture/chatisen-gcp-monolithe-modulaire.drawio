        <mxCell id="row-4-mark" parent="1" vertex="1" value="F05" style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#107158;spacing=0;align=center;verticalAlign=middle;">
          <mxGeometry as="geometry" x="106" y="2278" width="100" height="33" />
        </mxCell>
        <mxCell id="row-4-body-0" parent="1" vertex="1" value="&lt;b&gt;SQL interne&lt;/b&gt;&lt;br&gt;Dépôts PostgreSQL → Auth Proxy" style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="237" y="2267" width="679" height="55" />
        </mxCell>
        <mxCell id="row-4-body-1" parent="1" vertex="1" value="TCP 5432 privé. Les dépôts regroupent les requêtes de leur module sur la même instance." style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="940" y="2267" width="1177" height="55" />
        </mxCell>
        <mxCell id="row-4-body-2" parent="1" vertex="1" value="Port 5432 interne. Le code accède aux autres modules par leurs interfaces. Rôle SQL applicatif limité." style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="2140" y="2267" width="1270" height="55" />
        </mxCell>
        <mxCell id="row-5" parent="1" vertex="1" value="" style="rounded=1;absoluteArcSize=1;arcSize=7;fillColor=#f1f5fa;strokeColor=#c6d1df;strokeWidth=2;dashed=0;html=1;">
          <mxGeometry as="geometry" x="84" y="2326" width="3358" height="59" />
        </mxCell>
        <mxCell id="row-5-number" parent="1" vertex="1" value="" style="rounded=1;absoluteArcSize=1;arcSize=11;fillColor=#eaf7f0;strokeColor=#a0d0bb;strokeWidth=2;dashed=0;html=1;">
          <mxGeometry as="geometry" x="104" y="2339" width="104" height="33" />
        </mxCell>
        <mxCell id="row-5-mark" parent="1" vertex="1" value="F06" style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#107158;spacing=0;align=center;verticalAlign=middle;">
          <mxGeometry as="geometry" x="106" y="2339" width="100" height="33" />
        </mxCell>
        <mxCell id="row-5-body-0" parent="1" vertex="1" value="&lt;b&gt;Tunnel Cloud SQL&lt;/b&gt;&lt;br&gt;Auth Proxy → Cloud SQL" style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="237" y="2328" width="679" height="55" />
        </mxCell>
        <mxCell id="row-5-body-1" parent="1" vertex="1" value="Tunnel TLS TCP 3307 vers la base. Le proxy appelle aussi l’API Cloud SQL en HTTPS 443." style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="940" y="2328" width="1177" height="55" />
        </mxCell>
        <mxCell id="row-5-body-2" parent="1" vertex="1" value="IP privée via Private Services Access. Proxy avec réseau de sortie. Rôles Cloud SQL Client et Instance User sur VM APP, utilisateur IAM déclaré en base." style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="2140" y="2328" width="1270" height="55" />
        </mxCell>
        <mxCell id="row-6" parent="1" vertex="1" value="" style="rounded=1;absoluteArcSize=1;arcSize=7;fillColor=#ffffff;strokeColor=#c6d1df;strokeWidth=2;dashed=0;html=1;">
          <mxGeometry as="geometry" x="84" y="2387" width="3358" height="59" />
        </mxCell>
        <mxCell id="row-6-number" parent="1" vertex="1" value="" style="rounded=1;absoluteArcSize=1;arcSize=11;fillColor=#f4ecfc;strokeColor=#cbb1e5;strokeWidth=2;dashed=0;html=1;">
          <mxGeometry as="geometry" x="104" y="2400" width="104" height="33" />
        </mxCell>
        <mxCell id="row-6-mark" parent="1" vertex="1" value="F07" style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#7436a9;spacing=0;align=center;verticalAlign=middle;">
          <mxGeometry as="geometry" x="106" y="2400" width="100" height="33" />
        </mxCell>
        <mxCell id="row-6-body-0" parent="1" vertex="1" value="&lt;b&gt;STUN et TURN&lt;/b&gt;&lt;br&gt;Navigateurs ↔ IP TURN" style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="237" y="2389" width="679" height="55" />
        </mxCell>
        <mxCell id="row-6-body-1" parent="1" vertex="1" value="STUN/TURN 3478 TCP/UDP. Le média WebRTC utilise le P2P ou le relais UDP 49160–49259." style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="940" y="2389" width="1177" height="55" />
        </mxCell>
        <mxCell id="row-6-body-2" parent="1" vertex="1" value="Pare-feu TURN distinct. Identifiants HMAC courts pour TURN, quotas d’allocations et relais limité aux destinations autorisées." style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="2140" y="2389" width="1270" height="55" />
        </mxCell>
        <mxCell id="row-7" parent="1" vertex="1" value="" style="rounded=1;absoluteArcSize=1;arcSize=7;fillColor=#f1f5fa;strokeColor=#c6d1df;strokeWidth=2;dashed=0;html=1;">
          <mxGeometry as="geometry" x="84" y="2448" width="3358" height="59" />
        </mxCell>
        <mxCell id="row-7-number" parent="1" vertex="1" value="" style="rounded=1;absoluteArcSize=1;arcSize=11;fillColor=#f4ecfc;strokeColor=#cbb1e5;strokeWidth=2;dashed=0;html=1;">
          <mxGeometry as="geometry" x="104" y="2461" width="104" height="33" />
        </mxCell>
        <mxCell id="row-7-mark" parent="1" vertex="1" value="F08" style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#7436a9;spacing=0;align=center;verticalAlign=middle;">
          <mxGeometry as="geometry" x="106" y="2461" width="100" height="33" />
        </mxCell>
        <mxCell id="row-7-body-0" parent="1" vertex="1" value="&lt;b&gt;Relais média&lt;/b&gt;&lt;br&gt;IP TURN ↔ coturn" style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="237" y="2450" width="679" height="55" />
        </mxCell>
        <mxCell id="row-7-body-1" parent="1" vertex="1" value="NAT 1:1 de l’IP publique vers 10.10.0.20. Audio, vidéo et partage d’écran relayés." style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="940" y="2450" width="1177" height="55" />
        </mxCell>
        <mxCell id="row-7-body-2" parent="1" vertex="1" value="Docker en réseau hôte. Plage UDP définie sur coturn et le pare-feu. Média chiffré WebRTC (DTLS-SRTP)." style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="2140" y="2450" width="1270" height="55" />
        </mxCell>
        <mxCell id="row-8" parent="1" vertex="1" value="" style="rounded=1;absoluteArcSize=1;arcSize=7;fillColor=#ffffff;strokeColor=#c6d1df;strokeWidth=2;dashed=0;html=1;">
          <mxGeometry as="geometry" x="84" y="2509" width="3358" height="59" />
        </mxCell>
