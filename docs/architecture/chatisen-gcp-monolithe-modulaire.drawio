        </mxCell>
        <mxCell id="row-9-body-2" parent="1" vertex="1" value="Bucket privé. Compte de service limité aux objets nécessaires. Contrôler type, taille et accès au salon." style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
