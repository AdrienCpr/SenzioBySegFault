        <mxCell id="row-16-body-1" parent="1" vertex="1" value="F17a : APP. F17b : TURN. HTTPS 443 pour lire le secret nécessaire." style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
