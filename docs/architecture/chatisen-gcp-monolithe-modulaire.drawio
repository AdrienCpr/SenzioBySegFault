        <mxCell id="row-17-body-1" parent="1" vertex="1" value="Le nom principal et staging résolvent vers IP APP. Le sous-domaine TURN vers IP TURN. TTL 900 s." style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
