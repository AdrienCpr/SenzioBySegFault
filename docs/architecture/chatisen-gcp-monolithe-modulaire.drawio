        <mxCell id="row-9-body-0" parent="1" vertex="1" value="&lt;b&gt;Accès au stockage privé&lt;/b&gt;&lt;br&gt;Module Fichiers ↔ Cloud Storage" style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
