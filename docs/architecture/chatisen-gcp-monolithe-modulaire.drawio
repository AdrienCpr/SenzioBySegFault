        <mxCell id="row-2-body-0" parent="1" vertex="1" value="&lt;b&gt;Interface&lt;/b&gt;&lt;br&gt;Traefik → Nginx" style="shape=text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#17263d;spacing=0;align=left;verticalAlign=middle;">
