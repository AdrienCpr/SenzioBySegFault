{
  "name": "@chatisen/backend",
  "version": "0.1.0",
  "private": true,
  "description": "ChatISEN - backend Node.js (monolithe modulaire Fastify + Socket.IO)",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/jwt": "^10.2.8",
    "@socket.io/redis-adapter": "^8.3.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "redis": "^6.4.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
